# Deployment defaults. For development, copy backend/.env.example to backend/.env.
# The backend reads .env from its working directory. Saved application settings take precedence.

# Local OpenAI-compatible endpoint. Set the model to one you have installed.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=no-key
LLM_MODEL=

# Optional separate judge. Leave empty to follow the writing model.
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=

# Optional vision endpoint. Empty fields follow the writing model.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# Speech provider: whisper | assemblyai | speechmatics.
ASR_PROVIDER=whisper
WHISPER_BASE_URL=http://127.0.0.1:8081
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_REGION=us
SPEECHMATICS_API_KEY=
SPEECHMATICS_REGION=eu
ASR_POLL_TIMEOUT_S=1800

# Development data, resolved relative to backend/. Packaged backends require an absolute path.
KITE_DATA_DIR=./data
KITE_EXTRACT_MODEL=

HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173

# Official Memoket companion CLI; set an absolute executable path if needed.
MEMOKET_CLI=memoket
